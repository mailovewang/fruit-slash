rules_version = '2';
// 貼到 Firebase 主控台 → Firestore Database → 規則
// 管理員的 UID（用管理員帳號登入 admin.html 時畫面會顯示）
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'z262AsZ1VITNZ8dehfZzluDQOA73';
    }

    // 寫入內容檢查：恢復碼格式、只允許固定欄位、限制大小，避免被塞垃圾資料
    function validSave(code) {
      let d = request.resource.data;
      return code.matches('FRUIT-[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}')
        && d.keys().hasOnly(['name', 'save', 'version', 'updatedAt', 'stats'])
        && d.name is string && d.name.size() <= 40
        && d.version is string && d.version.size() <= 20
        && d.save is map && d.save.size() <= 40
        && d.stats is map && d.stats.size() <= 10
        && d.updatedAt == request.time;
    }

    // 每個玩家一份存檔，文件 ID 就是恢復碼
    match /saves/{code} {
      // 知道恢復碼才能讀那一份；無法列出全部（列表只給管理員）
      allow get: if true;
      allow list: if isAdmin();

      allow create: if validSave(code);
      // 限速：同一份存檔 2 秒內只能寫一次，防止被狂刷
      allow update: if validSave(code) && request.time > resource.data.updatedAt + duration.value(2, 's');

      allow delete: if isAdmin();
    }

    function authed() { return request.auth != null; }
    function fcode(c) { return c is string && c.matches('[2-9A-HJ-NP-Z]{6}'); }
    function shortStr(v, n) { return v is string && v.size() <= n; }
    function num(v, n) { return v is int && v >= 0 && v <= n; }

    // 遊戲設定（例如 config/event 活動開關）：大家都能讀，只有管理員能改
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 被管理員封鎖的玩家（文件 ID = uid）：不能再上排行榜、送禮、發挑戰
    function notBanned() { return !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    match /banned/{uid} {
      allow read, write: if isAdmin();
    }

    // 好友碼登記（不公開）：文件 ID = 好友碼，記錄目前是哪個帳號在用。
    // 只有「自己的雲端存檔（恢復碼 rc）裡記的好友碼就是這組」才能登記，換手機用恢復碼找回後也能重新登記，別人冒用不了。
    function validCodeClaim(code) {
      return authed() && fcode(code)
        && request.resource.data.keys().hasOnly(['uid', 'rc'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rc is string && request.resource.data.rc.matches('FRUIT-[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}')
        && get(/databases/$(database)/documents/saves/$(request.resource.data.rc)).data.save.friendCode == code;
    }
    match /codes/{code} {
      allow read, delete: if isAdmin();
      allow create: if validCodeClaim(code);
      // 換手機重新登記：必須用「第一次登記時的同一組恢復碼」（恢復碼不公開，別人拿不到）
      allow update: if validCodeClaim(code) && request.resource.data.rc == resource.data.rc;
    }
    function ownsCode(c) { return get(/databases/$(database)/documents/codes/$(c)).data.uid == request.auth.uid; }

    function validProfile() {
      let d = request.resource.data;
      return ownsCode(d.code)
        && d.keys().hasOnly(['code', 'name', 'title', 'blade', 'best', 'endless', 'cleared', 'updatedAt', 'week', 'wbest', 'pweek', 'pwbest'])
        && shortStr(d.get('week', ''), 12) && num(d.get('wbest', 0), 99999) && shortStr(d.get('pweek', ''), 12) && num(d.get('pwbest', 0), 99999)
        && fcode(d.code) && shortStr(d.name, 40) && shortStr(d.title, 40) && shortStr(d.blade, 20)
        && num(d.best, 99999) && num(d.endless, 999) && num(d.cleared, 50)
        && d.updatedAt == request.time;
    }

    // 每週排行榜防作弊：同一週每次最多加 5000；換新的一週從頭算（≤10000）；
    // 「上週成績」只能沿用原本記錄的那一週成績，不能事後改高
    function weekScoreOk() {
      let d = request.resource.data;
      let o = resource.data;
      return (d.get('week', '') == o.get('week', '') ? d.get('wbest', 0) <= o.get('wbest', 0) + 5000 : d.get('wbest', 0) <= 10000)
        && (d.get('pweek', '') == o.get('week', '') ? d.get('pwbest', 0) <= o.get('wbest', 0)
            : d.get('pweek', '') == o.get('pweek', '') ? d.get('pwbest', 0) <= o.get('pwbest', 0)
            : d.get('pwbest', 0) <= 10000);
    }

    // 公開資料（排行榜、好友用），文件 ID 是匿名登入的 uid，只有本人能改
    // 防作弊：新上榜最高 10000 分／無盡 100 隻；之後每次最多加 5000 分／30 隻，而且 5 秒內只能改一次
    //（2026-10-22 全服最高 3153 分、無盡 27 隻，正常玩不會碰到上限）
    match /profiles/{uid} {
      allow read: if true;
      allow create: if authed() && request.auth.uid == uid && notBanned() && validProfile()
        && request.resource.data.best <= 10000 && request.resource.data.endless <= 100
        && request.resource.data.get('wbest', 0) <= 10000 && request.resource.data.get('pwbest', 0) <= 10000;
      allow update: if authed() && request.auth.uid == uid && notBanned() && validProfile()
        && request.time > resource.data.updatedAt + duration.value(5, 's')
        && request.resource.data.best <= resource.data.best + 5000
        && request.resource.data.endless <= resource.data.endless + 30
        && weekScoreOk();
      allow delete: if isAdmin();
    }

    // 目前登入的人在 profiles 裡登記的好友碼（用來確認「收件人是不是本人」）
    function myCode() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.code; }

    // 好友禮物：文件 ID = 送的人_收的人_日期，所以每天每位好友只能送一次（不能覆蓋）
    match /gifts/{id} {
      allow read: if authed();
      // 只有收件人本人可以領取（刪除）禮物
      allow delete: if authed() && resource.data.to == myCode();
      // 只能用自己的好友碼送（不能冒充別人）
      allow create: if authed() && notBanned() && request.resource.data.from == myCode()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'day', 'at'])
        && fcode(request.resource.data.from) && fcode(request.resource.data.to) && shortStr(request.resource.data.fromName, 40)
        && shortStr(request.resource.data.day, 12) && request.resource.data.at == request.time
        && id == request.resource.data.from + '_' + request.resource.data.to + '_' + request.resource.data.day;
    }

    // 挑戰賽：建立時還沒有對手分數；對手只能填一次自己的分數
    match /challenges/{id} {
      allow read: if authed();
      // 只能用自己的好友碼發挑戰；60 秒挑戰分數上限 1000
      allow create: if authed() && notBanned() && request.resource.data.from == myCode()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'seed', 'score', 'reply', 'replyName', 'at'])
        && fcode(request.resource.data.from) && fcode(request.resource.data.to) && shortStr(request.resource.data.fromName, 40)
        && num(request.resource.data.seed, 2147483647) && num(request.resource.data.score, 1000)
        && request.resource.data.reply == null && request.resource.data.replyName == null && request.resource.data.at == request.time;
      // 只有被挑戰的人本人可以填自己的分數
      allow update: if authed() && resource.data.reply == null && resource.data.to == myCode()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'replyName'])
        && num(request.resource.data.reply, 1000) && shortStr(request.resource.data.replyName, 40);
      allow delete: if isAdmin();
    }
  }
}
